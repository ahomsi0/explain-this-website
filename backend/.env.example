# Server
PORT=8080
APP_ENV=development
ALLOWED_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Optional: comma-separated proxy IPs/CIDRs whose X-Forwarded-For header is trusted.
# REQUIRED in production behind a reverse proxy (Render, Vercel, nginx, …):
# without it every request shares the proxy's address, so per-IP rate limits
# collapse into one sitewide bucket. Keep it empty only for direct local dev.
TRUSTED_PROXY_CIDRS=
FETCH_TIMEOUT_SEC=60
MAX_BODY_BYTES=5242880
APP_URL=http://localhost:5173

# Database (required)
DATABASE_URL=postgres://user:password@localhost:5432/dbname?sslmode=disable

# Auth (required)
JWT_SECRET=change-me-to-a-long-random-secret
# 32-byte hex or base64 key used to encrypt webhook signing secrets at rest.
WEBHOOK_ENCRYPTION_KEY=replace-with-64-hex-characters

# Admin (optional — if unset, only homsiahmed16@gmail.com can perform admin actions)
ADMIN_EMAIL=

# PageSpeed (optional — leave empty to skip performance analysis)
PAGESPEED_API_KEY=

# Groq (optional — leave empty to skip the plain-English AI summary)
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Email / Resend (required for password reset and broadcasts)
RESEND_API_KEY=
FROM_EMAIL=noreply@explainthewebsite.com

# Tap Payments
TAP_SECRET_KEY=
TAP_MONTHLY_PLAN_ID=
TAP_YEARLY_PLAN_ID=
TAP_WEBHOOK_SECRET=
